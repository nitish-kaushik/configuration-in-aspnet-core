{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Title": "My Application Title AppSettings.json file",
  "App": {
    "Name": "ConfigDemo from AppSettings Json file",
    "Version": "1.0.0"
  },
  "ConnectionStrings": {
    "Default": "Server=.;Database=DemoDb;Trusted_Connection=True;",
    "Redis": "localhost:6379"
  },
  "Features": {
    "EnableSwagger": true,
    "EnableCaching": false
  },
  "AllowedHosts": [ "localhost", "example.com", "Thirdvalue" ],
  "Servers": [
    { "Name": "ServerA","Port": 5001 },
    { "Name": "ServerB", "Port": 5002 }
  ]
}
